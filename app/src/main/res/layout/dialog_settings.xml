<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <Switch
        android:id="@+id/switchNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Включить уведомления"
        android:textSize="16sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Время напоминаний:"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvTimeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:padding="8dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnPickTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Изменить время"
        android:layout_marginTop="8dp"/>

    <!-- НОВЫЙ ПУНКТ: Частота -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Частота проверок:"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvCheckFrequency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 раз"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnPickFrequency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Изменить частоту"
        android:layout_marginTop="8dp"/>
    
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="* Больше проверок — больше расход батареи."
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginTop="8dp"/>

</LinearLayout>
