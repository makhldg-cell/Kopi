<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        
        <!-- ДОБАВЛЕН inputType ДЛЯ ЗАГЛАВНОЙ БУКВЫ -->
        <EditText 
            android:id="@+id/etName" 
            android:layout_width="match_parent" 
            android:layout_height="wrap_content" 
            android:hint="Название цели" 
            android:inputType="textCapSentences"/>
            
        <EditText android:id="@+id/etTargetAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="К чему стремимся (Сумма)" android:inputType="numberDecimal" android:layout_marginTop="8dp"/>
        
        <Spinner android:id="@+id/spinnerCurrency" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Частота взносов (нажмите, чтобы изменить):" android:textStyle="bold" android:textColor="#1976D2" android:layout_marginTop="16dp"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_spinner_border" android:layout_marginTop="4dp">
            <Spinner android:id="@+id/spinnerFrequency" android:layout_width="match_parent" android:layout_height="50dp" android:paddingStart="12dp" android:paddingEnd="12dp"/>
        </FrameLayout>
        
        <EditText android:id="@+id/etDayOfWeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="День недели (1-7)" android:inputType="number" android:layout_marginTop="8dp" android:visibility="gone"/>
        <EditText android:id="@+id/etDayOfMonth1" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Число месяца (1-31)" android:inputType="number" android:layout_marginTop="8dp" android:visibility="gone"/>
        <EditText android:id="@+id/etDayOfMonth2" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Второе число (1-31)" android:inputType="number" android:layout_marginTop="8dp" android:visibility="gone"/>
        
        <EditText android:id="@+id/etPaymentAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Сумма одного взноса" android:inputType="numberDecimal" android:layout_marginTop="8dp"/>
        
        <Switch
            android:id="@+id/switchStrictMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Строгий режим (запрет правок графика до даты взноса)"
            android:layout_marginTop="16dp"/>

        <!-- ДОБАВЛЕН inputType ДЛЯ ССЫЛКИ -->
        <EditText 
            android:id="@+id/etLink" 
            android:layout_width="match_parent" 
            android:layout_height="wrap_content" 
            android:hint="Ссылка на товар (опционально)" 
            android:inputType="textUri"
            android:layout_marginTop="8dp"/>
            
        <EditText android:id="@+id/etComment" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Комментарий" android:inputType="textCapSentences" android:layout_marginTop="8dp"/>
        
        <TextView android:id="@+id/tvCalculatedDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="#2E7D32" android:textStyle="bold"/>
        
        <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Сохранить цель" android:layout_marginTop="24dp"/>
    </LinearLayout>
</ScrollView>
