<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        
        <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Название цели" />
        <EditText android:id="@+id/etTargetAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="К чему стремимся (Сумма)" android:inputType="numberDecimal" android:layout_marginTop="8dp"/>
        <Spinner android:id="@+id/spinnerCurrency" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Частота взносов:" android:textStyle="bold" android:layout_marginTop="16dp"/>
        <Spinner android:id="@+id/spinnerFrequency" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        
        <!-- Дни недели -->
        <Spinner android:id="@+id/spinnerDayOfWeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone"/>
        
        <!-- Числа месяца -->
        <Spinner android:id="@+id/spinnerDayOfMonth1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone"/>
        <Spinner android:id="@+id/spinnerDayOfMonth2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone"/>
        
        <EditText android:id="@+id/etPaymentAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Сумма взноса" android:inputType="numberDecimal" android:layout_marginTop="8dp"/>
        
        <EditText android:id="@+id/etLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ссылка на товар (опционально)" android:layout_marginTop="8dp"/>
        <EditText android:id="@+id/etComment" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Комментарий" android:layout_marginTop="8dp"/>
        
        <TextView android:id="@+id/tvCalculatedDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="#2E7D32" android:textStyle="bold"/>
        
        <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Сохранить цель" android:layout_marginTop="24dp"/>
    </LinearLayout>
</ScrollView>
